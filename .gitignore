# Curated research repository: keep the surrounding artifact workspace local.
/*
!/.gitignore
!/README.rst
!/docs/
/docs/*
!/docs/*.txt
!/docs/evidence-gallery.rst
!/evidence/
/evidence/*
!/evidence/*.json
!/evidence/screenshots/
/evidence/screenshots/*
!/evidence/screenshots/*.jpg
!/evidence/visual-session/
/evidence/visual-session/*
!/evidence/visual-session/*.json
!/evidence/visual-session/*.txt
!/tools/
/tools/*
!/tools/nanocore_dfu/
/tools/nanocore_dfu/*
!/tools/nanocore_dfu/uploader.py
!/tools/nanocore_dfu/test_uploader.py
!/tools/nanocore_dfu/README.txt
!/tools/host_pack/
/tools/host_pack/*
!/tools/host_pack/decode_host_pack.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml
